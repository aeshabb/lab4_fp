(** Синтаксические определения и операторы для парсер-комбинаторов *)

(** {1 Инфиксные операторы функтора} *)

val ( <$> ) : ('a -> 'b) -> 'a Parser.t -> 'b Parser.t
(** Инфиксный оператор для fmap: [f <$> p] *)

val ( <$ ) : 'a -> 'b Parser.t -> 'a Parser.t
(** Заменить результат константным значением *)

val ( $> ) : 'a Parser.t -> 'b -> 'b Parser.t
(** Заменить результат константным значением (аргументы переставлены) *)

(** {1 Инфиксные операторы аппликатива} *)

val ( <*> ) : ('a -> 'b) Parser.t -> 'a Parser.t -> 'b Parser.t
(** Аппликативное применение *)

val ( *> ) : 'a Parser.t -> 'b Parser.t -> 'b Parser.t
(** Последовательно выполнить два парсера, сохранить только результат второго *)

val ( <* ) : 'a Parser.t -> 'b Parser.t -> 'a Parser.t
(** Последовательно выполнить два парсера, сохранить только результат первого *)

(** {1 Инфиксные операторы альтернативы} *)

val ( <|> ) : 'a Parser.t -> 'a Parser.t -> 'a Parser.t
(** Альтернатива: попробовать первый парсер, при неуспехе — второй *)

(** {1 Монадические операторы} *)

val ( >>= ) : 'a Parser.t -> ('a -> 'b Parser.t) -> 'b Parser.t
(** Монадический bind *)

val ( >> ) : 'a Parser.t -> 'b Parser.t -> 'b Parser.t
(** Последовательное выполнение, результат первого парсера отбрасывается *)

(** {1 Let-binding операторы} *)

val ( let+ ) : 'a Parser.t -> ('a -> 'b) -> 'b Parser.t
(** Функторный let-binding: [let+ x = p in f x] эквивалентен [f <$> p] *)

val ( and+ ) : 'a Parser.t -> 'b Parser.t -> ('a * 'b) Parser.t
(** Аппликативный and-binding: [let+ x = p1 and+ y = p2 in (x, y)] *)

val ( let* ) : 'a Parser.t -> ('a -> 'b Parser.t) -> 'b Parser.t
(** Монадический let-binding: [let* x = p in f x] эквивалентен [p >>= f] *)

val ( and* ) : 'a Parser.t -> 'b Parser.t -> ('a * 'b) Parser.t
(** Монадический and-binding (аналогично and+) *)
